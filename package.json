{
  "name": "@rlevin/uirig",
  "version": "0.2.2",
  "description": "The first line of defense for AI-generated UIs and Web Components.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "uirig": "./bin/uirig"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "AGENTS.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck:all && npm test",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:playground": "tsc --noEmit -p playground/tsconfig.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:playground",
    "playground:dev": "vite playground",
    "playwright:verbose": "DEBUG=pw:protocol npx playwright test",
    "playground:test": "vitest run tests/integration/playground.test.ts",
    "playground:test:headed": "UIRIG_HEADED=1 vitest run tests/integration/playground.test.ts",
    "release": "bash scripts/release.sh",
    "release:publish": "bash scripts/release.sh --publish"
  },
  "keywords": [
    "ui",
    "ux",
    "design-tokens",
    "web-components",
    "shadow-dom",
    "accessibility",
    "contrast",
    "dark-mode",
    "cls",
    "ai-agents",
    "playwright",
    "cicd"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^6.0.0",
    "colorjs.io": "^0.7.1",
    "playwright": "^1.65.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
