{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "targetUrls": ["http://localhost:3000"],
  "tokensPath": "./config/default_tokens.json",
  "thresholdBudgets": {
    "clsMaxLimit": 0.1,
    "overflowPixelTolerance": 2,
    "touchTargetMinSpacingPx": 24
  },
  "viewports": [
    {
      "name": "mobile",
      "width": 375,
      "height": 812
    },
    {
      "name": "desktop",
      "width": 1440,
      "height": 900
    }
  ]
}
