#!/usr/bin/env node

/**
 * bin/uirig
 * Global CLI executable entry point.
 * Loads `runCli` from the compiled ESM entrypoint (`dist/index.js`) and exits
 * with the returned deterministic POSIX exit code (`0`, `1`, or `2`).
 */

import { existsSync } from 'fs';
import { fileURLToPath, pathToFileURL } from 'url';
import { dirname, resolve } from 'path';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
const entryPoint = resolve(__dirname, '../dist/index.js');

if (!existsSync(entryPoint)) {
  console.error(
    "[uirig:cli] Compiled binary not found at 'dist/index.js'. Run 'npm run build' first."
  );
  process.exit(1);
}

const { runCli } = await import(pathToFileURL(entryPoint).href);
const exitCode = await runCli(process.argv.slice(2));
process.exit(exitCode);
